# Example environment variables for deployment
API_KEY=changeme
PORT=3000
# If you want persistent DB, add a PostgreSQL plugin on Railway and set DATABASE_URL.
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# Or leave empty to use built-in JSON file database (not recommended for production on Railway without volume)
# XRAY_API_URL=http://xray-node:port
# XRAY_LOCAL_BIN=/usr/local/bin/xray
# XRAY_CONFIG_PATH=/etc/xray/config.json
